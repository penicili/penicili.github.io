---

<section id="contact" class="relative flex justify-center px-6 py-28">
  <div data-animate class="w-full max-w-5xl">
    <p
      class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-zinc-500"
    >
      // contact
    </p>
    <h2 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Get in touch
    </h2>
    <p class="mb-12 text-lg text-zinc-400">
      Have a question, a project idea, or just want to say hi? Feel free to
      reach out.
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        contacts.map((contact) => (
          <a
            href={contact.href}
            target={contact.href.startsWith("mailto") ? "_self" : "_blank"}
            rel="noopener noreferrer"
            class="contact-card group flex flex-col gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-(--eva-green) hover:bg-(--eva-panel)/20"
          >
            <div
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-700 bg-zinc-800 text-zinc-400 transition group-hover:border-(--eva-orange) group-hover:text-(--eva-orange)"
              set:html={contact.icon}
            />
            <div>
              <p class="mb-0.5 text-xs font-medium uppercase tracking-widest text-zinc-500">
                {contact.label}
              </p>
              <p class="text-sm font-medium text-zinc-300 transition group-hover:text-white">
                {contact.value}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
