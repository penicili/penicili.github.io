---
import HeroTyping from "./HeroTyping.tsx";

const exploring = ["Web Development", "DevOps", "Self-hosting"];

const navLinks = [
  // { label: 'Blogs', href: '/blogs' },
  { label: "About Me", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
  { label: "Resume", href: "/CV-ATS-KATON BAGASKORO.pdf" },
];
---

<section
  class="hero relative flex min-h-screen items-center justify-center px-6 py-20"
>
  <div
    class="content relative z-10 flex w-full max-w-5xl flex-col items-center gap-16 lg:flex-row lg:items-center"
  >
    <!-- Left: text -->
    <div class="flex-1">
      <HeroTyping client:load />

      <!-- Bio, tags, nav — disembunyikan sampai headline selesai diketik -->
      <div id="hero-body" class="hero-body">
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-(--eva-muted)">
          I tinker with homelab, ship small projects and document what I learn.
        </p>

        <div class="mb-12">
          <span
            class="mb-3 block font-mono text-xs font-medium uppercase tracking-widest text-(--eva-green)"
          >
            // currently exploring
          </span>
          <div class="flex flex-wrap gap-2">
            {
              exploring.map((tag) => (
                <span class="rounded-full border border-(--eva-green)/30 bg-(--eva-green)/10 px-4 py-1.5 text-sm text-(--eva-green) backdrop-blur-sm transition hover:border-(--eva-green)/70 hover:bg-(--eva-green)/20">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <nav class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link group flex items-center gap-2 text-(--eva-muted) transition-all duration-200 hover:text-(--eva-green)"
              >
                <span class="transition-transform duration-200 group-hover:translate-x-1">
                  ##
                </span>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="photo-wrapper shrink-0">
      <div class="photo-ring">
        <img
          src="/profile1.png"
          alt="Bagas"
          class="photo-img"
          width="280"
          height="280"
        />
      </div>
      <div class="photo-glow"></div>
    </div>
  </div>
</section>

<style>
  :global(.gradient-name) {
    background: linear-gradient(
      135deg,
      var(--eva-panel) 0%,
      var(--eva-panel) 72%,
      var(--eva-orange) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* wrapper yang menahan tinggi baris, terpisah dari elemen yang di-clip */
  :global(.name-wrap) {
    display: inline-block;
    min-height: 1.3em; /* ruang tetap, tidak collapse walau teks kosong */
    line-height: 1.3; /* cukup longgar untuk descender g/j/y/p */
    vertical-align: top;
  }

  .hero-body {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }

  .hero-body.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-ring {
    position: relative;
    z-index: 1;
    padding: 3px;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--eva-panel), var(--eva-green));
  }

  .photo-img {
    display: block;
    width: 280px;
    height: 280px;
    border-radius: 1rem;
    object-fit: cover;
    object-position: top center;
    background-color: var(--eva-void);
  }

  .photo-glow {
    position: absolute;
    inset: -24px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      var(--eva-orange) 0%,
      transparent 70%
    );
    opacity: 0.12;
    filter: blur(24px);
    z-index: 0;
    animation: pulse-glow 4s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 0.15;
      transform: scale(1);
    }
    50% {
      opacity: 0.3;
      transform: scale(1.08);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes fadein {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cursor {
    animation: blink 1.1s step-end infinite;
  }

  .content {
    animation: fadein 0.7s ease-out both;
  }
</style>

<script>
  const bodyEl = document.getElementById("hero-body");
  const revealBody = () => bodyEl?.classList.add("visible");

  document.addEventListener("hero-typing-complete", revealBody, { once: true });
</script>
