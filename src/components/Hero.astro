---
const exploring = ['WebDev', 'DevOps', 'Infrastructure'];

const navLinks = [
  // { label: 'Blogs', href: '/blogs' },
  { label: 'About Me', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
  { label: 'Resume', href: '/CV-ATS-KATON BAGASKORO.pdf' },
];
---

<section class="hero relative flex min-h-screen items-center justify-center px-6 py-20">
  <div class="content relative z-10 flex w-full max-w-5xl flex-col items-center gap-16 lg:flex-row lg:items-center">

    <!-- Left: text -->
    <div class="flex-1">
      <!-- Terminal tagline -->
      <p class="mb-8 flex items-center gap-2 font-mono text-sm text-indigo-400">
        <span class="text-indigo-500">❯</span>
        <span id="hero-tagline"></span>
        <span class="cursor inline-block h-4 w-2 bg-indigo-400"></span>
      </p>

      <!-- Headline -->
      <h1 class="mb-6 text-6xl font-bold tracking-tight text-white sm:text-7xl leading-tight">
        <span id="hero-line1"></span>
        <br />
        <span class="name-wrap">
          <span id="hero-line2" class="gradient-name"></span>
        </span>
      </h1>

      <!-- Bio, tags, nav — disembunyikan sampai headline selesai diketik -->
      <div id="hero-body" class="hero-body">
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-zinc-400">
          I tinker with homelab, ship small projects and document what I learn.
        </p>

        <div class="mb-12">
          <span class="mb-3 block font-mono text-xs font-medium uppercase tracking-widest text-zinc-500">
            // currently exploring
          </span>
          <div class="flex flex-wrap gap-2">
            {
              exploring.map((tag) => (
                <span class="rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-sm text-indigo-300 backdrop-blur-sm transition hover:border-indigo-400/60 hover:bg-indigo-500/20">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <nav class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link group flex items-center gap-2 text-zinc-400 transition-all duration-200 hover:text-white"
              >
                <span class="transition-transform duration-200 group-hover:translate-x-1">##</span>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="photo-wrapper shrink-0">
      <div class="photo-ring">
        <img
          src="/profile.png"
          alt="Bagas"
          class="photo-img"
          width="280"
          height="280"
        />
      </div>
      <div class="photo-glow"></div>
    </div>

  </div>
</section>

<style>
  .gradient-name {
    background: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* wrapper yang menahan tinggi baris, terpisah dari elemen yang di-clip */
  .name-wrap {
    display: inline-block;
    min-height: 1.3em;   /* ruang tetap, tidak collapse walau teks kosong */
    line-height: 1.3;    /* cukup longgar untuk descender g/j/y/p */
    vertical-align: top;
  }

  .hero-body {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hero-body.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .photo-ring {
    position: relative;
    z-index: 1;
    padding: 3px;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, #818cf8, #a78bfa, #38bdf8);
  }

  .photo-img {
    display: block;
    width: 280px;
    height: 280px;
    border-radius: 1rem;
    object-fit: cover;
    object-position: top center;
    background-color: #18181b;
  }

  .photo-glow {
    position: absolute;
    inset: -24px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, #6366f1 0%, transparent 70%);
    opacity: 0.2;
    filter: blur(24px);
    z-index: 0;
    animation: pulse-glow 4s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.08); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes fadein {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .cursor {
    animation: blink 1.1s step-end infinite;
  }

  .content {
    animation: fadein 0.7s ease-out both;
  }
</style>

<script>
  function typeText(el: HTMLElement, text: string, speed: number, onDone?: () => void) {
    let i = 0;
    const tick = () => {
      if (i < text.length) {
        el.textContent += text[i++];
        setTimeout(tick, speed);
      } else {
        onDone?.();
      }
    };
    tick();
  }

  const taglineEl = document.getElementById('hero-tagline') as HTMLElement;
  const line1El  = document.getElementById('hero-line1')  as HTMLElement;
  const line2El  = document.getElementById('hero-line2')  as HTMLElement;
  const bodyEl   = document.getElementById('hero-body')   as HTMLElement;

function deleteText(el: HTMLElement, speed: number, onDone?: () => void) {
  const tick = () => {
    const current = el.textContent ?? '';
    if (current.length > 0) {
      el.textContent = current.slice(0, -1);
      setTimeout(tick, speed);
    } else {
      onDone?.();
    }
  };
  tick();
}

function cycleNames(el: HTMLElement, names: string[], typeSpeed: number, deleteSpeed: number, holdMs: number) {
  let index = 0;
  const next = () => {
    index = (index + 1) % names.length;
    setTimeout(() => {
      deleteText(el, deleteSpeed, () => {
        typeText(el, names[index], typeSpeed, () => {
          setTimeout(next, holdMs);
        });
      });
    }, holdMs);
  };
  next();
}

setTimeout(() => {
  // Headline: "Hi, I'm" → jeda → "Bagas" → reveal body
  typeText(line1El, "Hi, I'm", 75, () => {
    setTimeout(() => {
      typeText(line2El, 'Bagas', 110, () => {
        setTimeout(() => bodyEl.classList.add('visible'), 200);
        // Setelah muncul, nama bergantian antara "Bagas" dan "Katon Bagaskoro"
        cycleNames(line2El, ['Bagas', 'Katon Bagaskoro'], 90, 50, 2200);
      });
    }, 150);
  });
  // Tagline paralel
  typeText(taglineEl, 'Building to learn, learning to build', 38);
}, 700);
</script>
