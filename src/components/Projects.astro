---
const projects = [
  {
    title: 'CTF Proxmoxer',
    description: 'Backend for my final project, built with FastAPI, to manage CTF VMs on Proxmox VE.',
    tags: ['Python', 'FastAPI', 'Proxmox'],
    github: 'https://github.com/penicili/ctf-proxmoxer',
    demo: null,
  },
  {
    title: 'Nightnetwork',
    description: 'Landing and store page for a minecraft server with simple CMS, built with astro',
    tags: ['Astro', 'Netlify'],
    github: 'https://github.com/penicili/night',
    demo: 'https://nightnetwork-dev.netlify.app/',
  },
  {
    title: 'Auth Service',
    description: 'Authentication service built with ExpressJS.',
    tags: ['Express', 'MongoDB', 'TypeScript'],
    github: 'https://github.com/penicili/auth-service/',
    demo: null,
  },
  {
    title: 'Learning Analytics Dashboard',
    description: 'Backend for my capstone project, built with FastAPI.',
    tags: ['Python', 'FastAPI'],
    github: 'https://github.com/penicili/capstone-backend',
    demo: null,
  },
  {
    title: 'Freshleaf Laundry',
    description: 'Simple laundry business page built with laravel',
    tags: ['Laravel'],
    github: 'https://github.com/FreshLeaf-Laundry/FreshLeaf',
    demo: null,
  }

];
---

<section id="projects" class="relative flex justify-center px-6 py-28">
  <div data-animate class="w-full max-w-5xl">

    <p class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-zinc-500">
      // projects
    </p>
    <h2 class="mb-12 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Some of my recent work.
    </h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {projects.map((project) => (
        <article class="group flex flex-col overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 transition duration-200 hover:border-zinc-600">

          <!-- Terminal header bar -->
    
          <div class="flex items-center border-b border-zinc-800 bg-zinc-800/50 px-4 py-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-600"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-600"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-zinc-600"></span>
            </div>

          </div>

          <!-- Content -->
          <div class="flex flex-1 flex-col p-5">
            <h3 class="mb-2 font-semibold text-white">{project.title}</h3>
            <p class="mb-4 flex-1 text-sm leading-relaxed text-zinc-400">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="mb-4 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded-md bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-4 border-t border-zinc-800 pt-4 text-sm">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-zinc-500 transition hover:text-white"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
                GitHub
              </a>
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-zinc-500 transition hover:text-indigo-400"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  Live Demo
                </a>
              )}
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
