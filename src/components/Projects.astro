---
import { projects } from "../data/projects";
import "../styles/projects.css";
---

<section id="projects" class="relative flex justify-center px-6 py-28">
  <div data-animate class="w-full max-w-5xl">
    <p
      class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-zinc-500"
    >
      // projects
    </p>
    <h2 class="mb-12 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Some of my works
    </h2>

    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <article
            class={`project-card ${index === 0 ? "project-card--featured" : ""}`}
          >
            <div class="project-card__chrome">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-orange)" />
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-panel)" />
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-green)" />
              </div>
              <span class="font-mono text-xs text-zinc-500">
                {String(index + 1).padStart(2, "0")} / {project.slug}
              </span>
            </div>

            {project.images && project.images.length > 0 && (
              <div class="project-card__media" data-carousel>
                <div class="project-card__media-track">
                  {project.images.map((img, imgIndex) => (
                    <a
                      href={img}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${project.title} preview ${imgIndex + 1} in a new tab`}
                      class="project-card__media-slide"
                    >
                      <img src={img} alt={`${project.title} preview ${imgIndex + 1}`} />
                    </a>
                  ))}
                </div>
                {project.images.length > 1 && (
                  <>
                    <button
                      type="button"
                      class="project-card__media-nav project-card__media-nav--prev"
                      aria-label="Previous image"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="project-card__media-nav project-card__media-nav--next"
                      aria-label="Next image"
                    >
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </button>
                    <div class="project-card__media-dots">
                      {project.images.map((_, dotIndex) => (
                        <button
                          type="button"
                          class="project-card__media-dot"
                          aria-label={`Go to image ${dotIndex + 1}`}
                        />
                      ))}
                    </div>
                  </>
                )}
              </div>
            )}

            <div class="project-card__body">
              <div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>

              <div>
                <div class="mb-5 flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="rounded-md bg-zinc-800 px-2.5 py-1 font-mono text-xs text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="project-card__links">
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      class="h-4 w-4"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 .315-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    GitHub
                  </a>
                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Live Demo <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".project-card__media-track");
    const slides = carousel.querySelectorAll<HTMLElement>(".project-card__media-slide");
    const prevBtn = carousel.querySelector<HTMLButtonElement>(".project-card__media-nav--prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".project-card__media-nav--next");
    const dots = carousel.querySelectorAll<HTMLButtonElement>(".project-card__media-dot");

    if (!track || slides.length === 0) return;

    const trackEl: HTMLElement = track;
    let current = 0;

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      trackEl.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle("project-card__media-dot--active", i === current);
      });
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => goTo(i));
    });

    goTo(0);
  });
</script>
