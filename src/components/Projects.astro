---
type Project = {
  title: string;
  slug: string;
  description: string;
  tags: string[];
  github: string;
  demo: string | null;
  image?: string;
};

const projects: Project[] = [
  {
    title: "CTF Proxmoxer",
    slug: "ctf-proxmoxer",
    description:
      "A FastAPI backend that integrates Proxmox VE with Ansible to automate the provisioning and management of CTF virtual machines.",
    tags: ["Python", "FastAPI", "Ansible", "Proxmox"],
    image: "/proxmoxer.png",
    github: "https://github.com/penicili/ctf-proxmoxer",
    demo: null,
  },
  {
    title: "MyShortlink",
    slug: "myshortlink",
    description:
      "A lightweight URL-shortening API and deployment exercise focused on CI/CD pipelines and Kubernetes.",
    tags: ["Kubernetes", "Jenkins", "GitHub Actions", "ArgoCD", "Backstage"],
    github: "https://github.com/penicili/myshortlink",
    demo: null,
  },
  {
    title: "Nightnetwork",
    slug: "nightnetwork",
    description:
      "A CMS-backed landing and store site for a Minecraft server, built with Astro and deployed on Netlify.",
    tags: ["Astro", "Netlify"],
    github: "https://github.com/night-network-mc/nightnetwork-landing",
    demo: "https://nightnetwork-dev.netlify.app/",
  },
  {
    title: "Flask shortlink",
    slug: "flask-shortlink",
    description:
      "A Flask-based URL shortener provisioned on AWS with Terraform, exploring infrastructure as code and cloud deployment.",
    tags: ["Python", "Flask", "AWS", "Terraform"],
    github: "https://github.com/penicili/cloudinfra-proj",
    demo: null,
  },
  {
    title: "Auth Service",
    slug: "auth-service",
    description:
      "A TypeScript authentication service built with Express and MongoDB.",
    tags: ["Express", "MongoDB", "TypeScript"],
    github: "https://github.com/penicili/auth-service/",
    demo: null,
  },
  {
    title: "Learning Analytics Dashboard",
    slug: "learning-analytics-dashboard",
    description:
      "A FastAPI backend for a learning analytics dashboard, developed as part of my capstone project.",
    tags: ["Python", "FastAPI"],
    github: "https://github.com/penicili/capstone-backend",
    demo: null,
  },
  {
    title: "Freshleaf Laundry",
    slug: "freshleaf-laundry",
    description:
      "A Laravel website for Freshleaf Laundry, created to present the business and its services online.",
    tags: ["Laravel"],
    github: "https://github.com/FreshLeaf-Laundry/FreshLeaf",
    demo: null,
  },
];
---

<section id="projects" class="relative flex justify-center px-6 py-28">
  <div data-animate class="w-full max-w-5xl">
    <p
      class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-zinc-500"
    >
      // projects
    </p>
    <h2 class="mb-12 text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Some of my recent work.
    </h2>

    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <article
            class={`project-card ${index === 0 ? "project-card--featured" : ""}`}
          >
            <div class="project-card__chrome">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-orange)" />
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-panel)" />
                <span class="h-2.5 w-2.5 rounded-full bg-(--eva-green)" />
              </div>
              <span class="font-mono text-xs text-zinc-500">
                {String(index + 1).padStart(2, "0")} / {project.slug}
              </span>
            </div>

            {project.image && (
              <div class="project-card__media">
                <a
                  href={project.image}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} preview in a new tab`}
                >
                  <img src={project.image} alt={`${project.title} preview`} />
                </a>
              </div>
            )}

            <div class="project-card__body">
              <div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>

              <div>
                <div class="mb-5 flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="rounded-md bg-zinc-800 px-2.5 py-1 font-mono text-xs text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="project-card__links">
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      class="h-4 w-4"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 .315-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    GitHub
                  </a>
                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Live Demo <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(118 88 153 / 0.55);
    border-radius: 0.85rem;
    background: linear-gradient(
      145deg,
      rgb(118 88 153 / 0.22),
      rgb(0 0 0 / 0.96)
    );
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      background 0.25s ease;
  }

  .project-card:hover {
    border-color: rgb(65 187 66 / 0.8);
    background: linear-gradient(
      145deg,
      rgb(232 121 12 / 0.15),
      rgb(0 0 0 / 0.98)
    );
    transform: translateY(-0.25rem);
  }

  .project-card--featured {
    grid-row: span 2;
    min-height: 45rem;
  }

  .project-card__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(63 63 70 / 0.75);
    background: rgb(118 88 153 / 0.24);
    padding: 0.8rem 1rem;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
  }

  .project-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 7;
    border-bottom: 1px solid rgb(63 63 70 / 0.75);
    background: #000000;
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-card--featured .project-card__media {
    aspect-ratio: 16 / 9;
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    color: var(--eva-ink);
    font-size: 1.45rem;
    font-weight: 600;
  }

  .project-card--featured h3 {
    max-width: 18rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .project-card p {
    max-width: 34rem;
    color: var(--eva-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-top: 1px solid rgb(63 63 70 / 0.75);
    padding-top: 1rem;
    font-size: 0.82rem;
  }

  .project-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--eva-muted);
    transition: color 0.2s ease;
  }

  .project-card__links a:hover {
    color: var(--eva-green);
  }

  @media (max-width: 640px) {
    .projects-grid {
      display: flex;
      overflow-x: auto;
      gap: 1rem;
      padding: 0.25rem 0.25rem 1rem;
      scroll-snap-type: x mandatory;
      scrollbar-color: var(--eva-green) rgb(63 63 70 / 0.5);
      scrollbar-width: thin;
    }

    .project-card {
      flex: 0 0 82vw;
      min-height: 30rem;
      scroll-snap-align: start;
    }

    .project-card--featured {
      grid-row: auto;
      min-height: 30rem;
    }
  }
</style>
