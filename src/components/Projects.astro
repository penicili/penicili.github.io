---
const projects = [
  {
    title: 'Project One',
    description: 'Short description of what this project does and the problem it solves.',
    thumbnail: '/projects/project-one.jpg',
    tags: ['Laravel', 'Docker'],
    github: 'https://github.com/penicili/project-one',
    demo: null,
  },
  {
    title: 'Project Two',
    description: 'Short description of what this project does and the problem it solves.',
    thumbnail: '/projects/project-two.jpg',
    tags: ['FastAPI', 'Ansible'],
    github: 'https://github.com/penicili/project-two',
    demo: 'https://example.com',
  },
  {
    title: 'Project Three',
    description: 'Short description of what this project does and the problem it solves.',
    thumbnail: '/projects/project-three.jpg',
    tags: ['Express', 'Proxmox'],
    github: 'https://github.com/penicili/project-three',
    demo: null,
  },
];
---

<section class="relative flex justify-center px-6 py-28">
  <div class="w-full max-w-5xl">

    <p class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-zinc-500">
      // projects
    </p>
    <div class="mb-12 flex items-end justify-between">
      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Things I&rsquo;ve built
      </h2>
      <a
        href="/projects"
        class="hidden text-sm text-zinc-500 underline-offset-4 transition hover:text-indigo-400 hover:underline sm:block"
      >
        View all →
      </a>
    </div>

    <!-- Project grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="project-card group flex flex-col overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900 transition hover:border-zinc-700">

          <!-- Thumbnail -->
          <div class="thumbnail-wrap relative overflow-hidden bg-zinc-800">
            <img
              src={project.thumbnail}
              alt={project.title}
              class="h-48 w-full object-cover transition duration-300 group-hover:scale-105"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <!-- Fallback placeholder -->
            <div class="placeholder absolute inset-0 hidden items-center justify-center bg-zinc-800">
              <span class="font-mono text-2xl text-zinc-600">{project.title[0]}</span>
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-1 flex-col p-5">
            <h3 class="mb-2 font-semibold text-white">{project.title}</h3>
            <p class="mb-4 flex-1 text-sm leading-relaxed text-zinc-400">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="mb-4 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded-md bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-4 border-t border-zinc-800 pt-4 text-sm">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-zinc-500 transition hover:text-white"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
                GitHub
              </a>
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-zinc-500 transition hover:text-indigo-400"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  Live Demo
                </a>
              )}
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- Mobile: view all link -->
    <div class="mt-8 text-center sm:hidden">
      <a
        href="/projects"
        class="text-sm text-zinc-500 underline-offset-4 transition hover:text-indigo-400 hover:underline"
      >
        View all →
      </a>
    </div>

  </div>
</section>
