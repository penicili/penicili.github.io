---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Aboutme from '../components/Aboutme.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Home">
  <main class="relative min-h-screen overflow-hidden bg-zinc-950">
    <!-- Dot grid -->
    <div class="dot-grid absolute inset-0 opacity-25 pointer-events-none"></div>

    <!-- Radial glow -->
    <div class="pointer-events-none absolute left-1/2 top-1/3 h-150 w-175 -translate-x-1/2 -translate-y-1/2 rounded-full bg-indigo-600/10 blur-3xl"></div>

    <Hero />
    <Aboutme />
    <Projects />
    <Contact />
  </main>
</Layout>

<style>
  .dot-grid {
    background-image: radial-gradient(
      circle,
      rgb(113 113 122 / 0.5) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
  }
</style>
